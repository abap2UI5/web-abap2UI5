{
  "name": "browser-demo",
  "private": true,
  "version": "1.0.0",
  "description": "abap2UI5 running fully in the browser - @abap2ui5/node-runtime and the samples, transpiled to JS and bundled for GitHub Pages.",
  "scripts": {
    "check": "npm run clone && npm test && npm run build:web",
    "clone": "npm run clone:samples",
    "clone:samples": "node ci/clone.mjs samples",
    "build": "npm run build:transpile",
    "build:transpile": "node ci/transpile.mjs",
    "build:web": "webpack --mode production",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node output/index.mjs",
    "test:e2e": "playwright test --project=chromium-web",
    "media": "node media/record.mjs",
    "serve:build": "node srv/serve_build.mjs",
    "serve:express": "node srv/express.mjs",
    "serve:webpack": "webpack serve --mode development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5/browser-demo.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5/browser-demo/issues"
  },
  "homepage": "https://github.com/abap2UI5/browser-demo#readme",
  "devDependencies": {
    "@abap2ui5/node-runtime": "1.150.0",
    "@abaplint/transpiler-cli": "2.14.33",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "express": "^5.3.0",
    "html-webpack-plugin": "^5.6.8",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "sql.js": "^1.14.2",
    "terser-webpack-plugin": "^5.6.1",
    "web-encoding": "^1.1.5",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
